{
	"schemaVersion": 1,
	"id": "armorupgrades",
	"version": "${version}",
	"name": "Armor Upgrades",
	"description": "A lightweight mod that adds effects to armor trims.",
	"authors": [
		"Archangel-Styx"
	],
	"contact": {
		"homepage": "https://github.com/archangel-styx/",
		"sources": "https://github.com/archangel-styx/armorupgrades"
	},
	"license": "MIT",
	"icon": "assets/armorupgrades/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.archangel_styx.ArmorUpgrades"
		],
		"client": [
			"com.github.archangel_styx.client.ArmorUpgradesClient"
		]
	},
	"mixins": [
		"armorupgrades.mixins.json",
		{
			"config": "armorupgrades.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}